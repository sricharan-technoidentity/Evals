# Copy to .env (Inspect loads it automatically). Never commit .env.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Kiro (default)
#   The agent under test is Kiro CLI in headless mode, and the PR-description
#   grader also runs through kiro-cli. Needs kiro-cli installed and a Kiro
#   API key from app.kiro.dev -> API Keys (Pro / Pro+ / Pro Max / Power plans).
#   Usage is deducted from your Kiro subscription credits.
#   List valid model ids with:  kiro-cli chat --list-models
# ---------------------------------------------------------------------------
KIRO_API_KEY=ksk_...
SDLC_AGENT=kiro
INSPECT_EVAL_MODEL=kiro/claude-sonnet-4.6
INSPECT_EVAL_MODEL_ROLE=grader=kiro/claude-sonnet-4.6
INSPECT_LOG_DIR=./logs

# Optional: path to the kiro-cli binary if it is not on PATH
# KIRO_CLI_BIN=/home/you/.local/bin/kiro-cli

# ---------------------------------------------------------------------------
# Alternative: Inspect's own react agent over the Anthropic API
#   Comment out the Kiro block above and uncomment this one.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# SDLC_AGENT=react
# INSPECT_EVAL_MODEL=anthropic/claude-sonnet-5-5
# INSPECT_EVAL_MODEL_ROLE=grader=anthropic/claude-haiku-5-5
# INSPECT_LOG_DIR=./logs
#
#   If your key is not scoped to a workspace, also set (same wrkspc_ id twice):
# INSPECT_EVAL_EXTRA_HEADERS={"anthropic-workspace-id": "wrkspc_XXXX"}
# INSPECT_EVAL_MODEL_ROLE=grader={model: anthropic/claude-haiku-5-5, extra_headers: {anthropic-workspace-id: wrkspc_XXXX}}
