{
  "id": "PET-002",
  "title": "Owner search by last name should be case-insensitive",
  "difficulty": "medium",
  "repo": {
    "name": "spring-petclinic",
    "language": "java",
    "url": "https://github.com/spring-projects/spring-petclinic",
    "commit": "500158f732419217507c7656904b8e6aa1bcc0d6"
  },
  "setup": [
    "./mvnw -B -q -DskipTests -Dspring-javaformat.skip=true -Dspring-javaformat.validate.skip=true -Dcheckstyle.skip=true test-compile"
  ],
  "checks": [
    {
      "name": "maven: javaformat + checkstyle + tests",
      "cmd": "./mvnw -B test -Dtest='!MySqlIntegrationTests,!PostgresIntegrationTests' -Dsurefire.failIfNoSpecifiedTests=false"
    }
  ],
  "scope": {
    "allowed": [
      "src/main/java/org/springframework/samples/petclinic/owner/OwnerRepository.java",
      "src/main/java/org/springframework/samples/petclinic/owner/OwnerController.java",
      "src/test/java/*"
    ],
    "protected": [
      "pom.xml",
      "build.gradle",
      "mvnw",
      "mvnw.cmd",
      ".mvn/*",
      "gradle/*",
      "src/checkstyle/*",
      ".github/*",
      "src/main/resources/db/*"
    ],
    "test_globs": [
      "src/test/java/*"
    ],
    "max_changed_lines": 150
  },
  "hidden_tests": {
    "files": {
      "src/test/java/org/springframework/samples/petclinic/OwnerSearchCaseInsensitiveHiddenTests.java": "hidden_tests/OwnerSearchCaseInsensitiveHiddenTests.java"
    },
    "cmd": "./mvnw -B test -Dtest=OwnerSearchCaseInsensitiveHiddenTests -Dsurefire.failIfNoSpecifiedTests=false -Dspring-javaformat.skip=true -Dspring-javaformat.validate.skip=true -Dcheckstyle.skip=true"
  }
}
